.DS_Store

# Claude Code personal/local settings (may reference this machine's own devices)
.claude/settings.local.json

# iOS
ios/Shonan_Lite/.build/
ios/Shonan_Lite/Frameworks/
ios/Shonan_Lite/xcuserdata/
ios/Shonan_Lite/DerivedData/
*.xcuserstate

# Android
android/build/
android/*/build/
android/.gradle/
android/.kotlin/
android/local.properties
android/*.iml
android/.idea/
android/.cxx/
android/*/.cxx/

# Android third_party: ビルド中間生成物のみ除外。成果物(ffmpeg-mpegts-install-arm64-v8a/、
# dvbs2-deps-install-arm64-v8a/)は他プロジェクトの前例(ffmpeg-install-arm64-v8a/約12MB)に
# 倣いgit管理下に置く。
android/third_party/.build-tmp/
android/third_party/.build-tmp-dvbs2/

# Pi5 native build/runtime artifacts (依存ライブラリはPi5上で別途ビルド、
# ~/shonan-pi5-native-build/参照。runtime/はrun_tx.shが実行時に生成)
pi5/build/
pi5/runtime/
pi5/gui/__pycache__/
pi5/gui/screens/__pycache__/
pi5/tests/__pycache__/

# KiCad local artifacts (プロジェクトを開くと自動生成される、環境依存のもの)
**/.history/
**/*-backups/
**/~*.lck

# KiCadの画面の状態(レイヤーの表示・拡大率など)。設計データではないので管理しない
*.kicad_prl
